{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized external evaluator result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "raw_reward",
    "failure_reason",
    "input_tokens",
    "output_tokens",
    "cache_read_tokens",
    "cache_write_tokens",
    "usage_kind",
    "actual_cost_usd",
    "estimated_cost_usd",
    "cost_source",
    "simulated_cost_units",
    "simulated_time_seconds",
    "model",
    "harness_version"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "raw_reward": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cache_read_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cache_write_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "usage_kind": {
      "enum": [
        "synthetic",
        "provider_reported",
        "unavailable",
        "not_dispatched"
      ]
    },
    "actual_cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "estimated_cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "cost_source": {
      "type": "string",
      "minLength": 1
    },
    "simulated_cost_units": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "simulated_time_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "harness_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "wall_time_seconds": {
      "type": "number",
      "minimum": 0
    },
    "model_api_calls": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "measurement_error": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
