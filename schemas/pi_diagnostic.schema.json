{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded validation diagnostic, never a full HPO campaign",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "campaign_config", "primary_task", "secondary_task", "selection_reason", "evaluation_seed", "max_attempts", "spend_cap_usd", "wall_time_seconds"],
  "properties": {
    "schema_version": {"const": 1},
    "campaign_config": {"type": "string", "minLength": 1},
    "primary_task": {"type": "string"},
    "secondary_task": {"type": "string"},
    "selection_reason": {"type": "string", "minLength": 1},
    "evaluation_seed": {"type": "integer", "minimum": 0},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 8},
    "spend_cap_usd": {"type": "number", "exclusiveMinimum": 0, "maximum": 5},
    "wall_time_seconds": {"type": "integer", "minimum": 1, "maximum": 10800}
  }
}
